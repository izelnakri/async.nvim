// Does finally() catch all the catch() stuff? because thats where abort() calls

function myCoolPromiseAPI(/* …, */ { signal }) {
  return new Promise((resolve, reject) => {
    if (signal.aborted) {
      reject(signal.reason);
    }

    signal.addEventListener("abort", () => {
      reject(signal.reason);
    });
  });
}

